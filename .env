# ── EPANET Hydraulic Simulation Service — environment variables ──────────────
# Copy this file to .env and fill in your values.

# ── API keys ──────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys.
# The main system must send one of these in the X-API-Key header.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=0T_kF9Nq8_MhpzVwYPWyCx9kqST9RxRDowehDMBICps

# ── file storage ──────────────────────────────────────────────────────────────
# Absolute path (inside the container) where .gpkg files are mounted.
GPKG_DIR=./data/gpkg

# ── simulation defaults ───────────────────────────────────────────────────────
DEFAULT_DURATION_HRS=24
DEFAULT_TIMESTEP_MIN=60
DEFAULT_BASE_DEMAND=0.001
MIN_PRESSURE_M=7.0
MAX_VELOCITY_MS=3.0

# ── database ──────────────────────────────────────────────────────────────────
# SQLite file stored inside the container (persisted via volume mount).
DATABASE_URL=sqlite+aiosqlite:///./data/db/epanet_service.db

# ── service ───────────────────────────────────────────────────────────────────
SERVICE_NAME=EPANET Hydraulic Service
SERVICE_VERSION=1.0.0
DEBUG=false

MAJISCOPE_BACKEND_URL=http://localhost:8000
MAJISCOPE_RETURN_URL=http://localhost:3000/dashboard
#MAJISCOPE_BACKEND_URL=https://full-nfjr.onrender.com
#MAJISCOPE_RETURN_URL=https://majiscope-2wzv.onrender.com/dashboard
MAJISCOPE_LAUNCH_SECRET=GM1NBfP1IfPVqZtvtVv96rp3ZSxzFz-F-pc5qo1dIug
