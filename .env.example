# ── DUWASA DMA Hydraulic Simulation Service — environment variables ─────────
# Copy to .env and fill in your values before running docker compose.

# ── API keys ─────────────────────────────────────────────────────────────────
# Comma-separated list.  The calling system must send one in X-API-Key.
# Generate a key:  python -c "import secrets; print(secrets.token_hex(32))"
API_KEYS=change-me-key-1,change-me-key-2

# ── file storage ─────────────────────────────────────────────────────────────
# Absolute path (inside the container) where .gpkg files are stored.
# Override when using a host bind-mount instead of a named volume.
GPKG_DIR=/data/gpkg

# ── simulation defaults ───────────────────────────────────────────────────────
DEFAULT_DURATION_HRS=24
DEFAULT_TIMESTEP_MIN=60
DEFAULT_BASE_DEMAND=0.011
MIN_PRESSURE_M=7.0
MAX_VELOCITY_MS=3.0

# ── database ──────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:////data/db/dma_sim.db

# ── service metadata ──────────────────────────────────────────────────────────
SERVICE_NAME=DUWASA DMA Simulation Service
SERVICE_VERSION=2.0.0
DEBUG=false

# ── MajiScope integration ────────────────────────────────────────────────────
MAJISCOPE_BACKEND_URL=https://full-nfjr.onrender.com
MAJISCOPE_RETURN_URL=https://majiscope-2wzv.onrender.com/dashboard
MAJISCOPE_LAUNCH_SECRET=change-me-launch-secret
MAJISCOPE_CALLBACK_SECRET=change-me-callback-secret
